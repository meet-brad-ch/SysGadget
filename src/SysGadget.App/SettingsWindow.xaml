<Window x:Class="SysGadget.App.SettingsWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:SysGadget.App"
        Title="SysGadget settings"
        Width="400"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Topmost="True">
    <Window.Resources>
        <app:MeterTitleConverter x:Key="MeterTitle" />
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>
    <StackPanel Margin="14">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="46" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="32" />
                <RowDefinition Height="32" />
                <RowDefinition Height="32" />
                <RowDefinition Height="32" />
                <RowDefinition Height="32" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Dock to" />
            <ComboBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" x:Name="EdgeBox" Height="24"
                      SelectedItem="{Binding Edge}" />

            <TextBlock Grid.Row="1" Text="Monitor" />
            <ComboBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" x:Name="MonitorBox" Height="24"
                      SelectedIndex="{Binding MonitorIndex}" />

            <TextBlock Grid.Row="2" Text="Width (px)" />
            <Slider Grid.Row="2" Grid.Column="1" Minimum="120" Maximum="800" TickFrequency="10"
                    IsSnapToTickEnabled="True" Value="{Binding Width}" VerticalAlignment="Center" />
            <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding Width}" HorizontalAlignment="Right" />

            <TextBlock Grid.Row="3" Text="Opacity" />
            <Slider Grid.Row="3" Grid.Column="1" Minimum="0.2" Maximum="1" TickFrequency="0.05"
                    IsSnapToTickEnabled="True" Value="{Binding Opacity}" VerticalAlignment="Center" />
            <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding Opacity, StringFormat=P0}"
                       HorizontalAlignment="Right" />

            <TextBlock Grid.Row="4" Text="Update every" />
            <ComboBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" x:Name="IntervalBox" Height="24"
                      SelectedItem="{Binding IntervalMs}" ItemStringFormat="{}{0} ms" />

            <CheckBox Grid.Row="5" Grid.ColumnSpan="3" Content="Always on top" VerticalAlignment="Center"
                      IsChecked="{Binding AlwaysOnTop}" />
        </Grid>

        <CheckBox Margin="0,4,0,0" IsChecked="{Binding UseLibreHardwareMonitor}"
                  Content="Use LibreHardwareMonitor (temperatures; restarts as administrator)" />

        <TextBlock Margin="0,12,0,4" FontWeight="SemiBold" Text="Meters (checked = shown)" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ListBox x:Name="MeterList" Height="190" ItemsSource="{Binding Meters}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <CheckBox IsChecked="{Binding Visible}" Content="{Binding Id, Converter={StaticResource MeterTitle}}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                <Button Content="Up" Width="56" Height="26" Click="OnMoveUp" />
                <Button Content="Down" Width="56" Height="26" Margin="0,6,0,0" Click="OnMoveDown" />
            </StackPanel>
        </Grid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="OK" Width="76" Height="28" IsDefault="True" Click="OnOk" />
            <Button Content="Apply" Width="76" Height="28" Margin="8,0,0,0" Click="OnApply" />
            <Button Content="Cancel" Width="76" Height="28" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
