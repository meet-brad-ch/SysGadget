<Window x:Class="SysGadget.App.SettingsWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SysGadget.App"
        Title="SysGadget settings"
        Width="440"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Topmost="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,12,0,4" />
        </Style>
        <!-- Lines above and below a row; the one where a dragged row would land turns blue. -->
        <Style x:Key="LineBefore" TargetType="Rectangle">
            <Setter Property="Height" Value="2" />
            <Setter Property="Fill" Value="Transparent" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DropMark}" Value="Before">
                    <Setter Property="Fill" Value="#2F7BEF" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="LineAfter" TargetType="Rectangle">
            <Setter Property="Height" Value="2" />
            <Setter Property="Fill" Value="Transparent" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DropMark}" Value="After">
                    <Setter Property="Fill" Value="#2F7BEF" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <StackPanel Margin="14,4,14,14">
        <TextBlock Style="{StaticResource SectionTitle}" Text="Layout" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="46" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Position" />
            <ComboBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" x:Name="EdgeBox" Height="24"
                      SelectedItem="{Binding Edge}" SelectionChanged="OnEdgeChanged" />

            <TextBlock Grid.Row="1" Text="Monitor" />
            <ComboBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" x:Name="MonitorBox" Height="24"
                      SelectedIndex="{Binding MonitorIndex}" />

            <TextBlock Grid.Row="2" Text="Card width (px)" />
            <Slider Grid.Row="2" Grid.Column="1" Minimum="200" Maximum="800" TickFrequency="10"
                    IsSnapToTickEnabled="True" Value="{Binding Width}" VerticalAlignment="Center" />
            <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding Width}" HorizontalAlignment="Right" />

            <TextBlock Grid.Row="3" Text="Opacity" />
            <Slider Grid.Row="3" Grid.Column="1" Minimum="0.2" Maximum="1" TickFrequency="0.05"
                    IsSnapToTickEnabled="True" Value="{Binding Opacity}" VerticalAlignment="Center" />
            <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding Opacity, StringFormat=P0}"
                       HorizontalAlignment="Right" />
        </Grid>

        <CheckBox Margin="0,4,0,0" IsChecked="{Binding AlwaysOnTop}" Content="Always on top" />
        <CheckBox Margin="0,4,0,0" IsChecked="{Binding ThinBar}"
                  Content="Thin bar: one line per group (double-click the gadget to switch)" />
        <CheckBox Margin="0,4,0,0" x:Name="ColumnsBox" IsChecked="{Binding Horizontal}"
                  Content="Groups side by side as columns (floating only)" />
        <CheckBox Margin="0,4,0,0" x:Name="ReserveBox" IsChecked="{Binding ReserveSpace}"
                  Content="Reserve screen space (docked only; windows stop at the gadget)" />

        <TextBlock Style="{StaticResource SectionTitle}" Text="Data" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
            </Grid.RowDefinitions>
            <TextBlock Text="Update every" />
            <ComboBox Grid.Column="1" x:Name="IntervalBox" Height="24"
                      SelectedItem="{Binding IntervalMs}" ItemStringFormat="{}{0} ms" />
            <TextBlock Grid.Row="1" Text="Bandwidth (Mbit/s)" />
            <TextBox Grid.Row="1" Grid.Column="1" x:Name="BandwidthBox" Height="24" VerticalContentAlignment="Center"
                     Text="{Binding NetworkMbit, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Speed of the internet connection: a full Down or Up bar" />
        </Grid>
        <CheckBox Margin="0,6,0,0" IsChecked="{Binding UseCompactCores}" Content="Show the cores as vertical bars" />

        <TextBlock Style="{StaticResource SectionTitle}" Text="Groups and items" />
        <TextBlock TextWrapping="Wrap" Foreground="#555" Margin="0,0,0,6"
                   Text="Tick what to show. Drag a group or an item to change the order; items stay in their group. The first ticked item of a group is the one the thin bar shows (marked)." />
        <TreeView x:Name="MeterTree" Height="280" AllowDrop="True"
                  PreviewMouseLeftButtonDown="OnTreeMouseDown" PreviewMouseMove="OnTreeMouseMove"
                  DragOver="OnTreeDragOver" DragLeave="OnTreeDragLeave" Drop="OnTreeDrop">
            <TreeView.ItemContainerStyle>
                <Style TargetType="TreeViewItem">
                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                </Style>
            </TreeView.ItemContainerStyle>
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                    <StackPanel Background="Transparent" Cursor="SizeAll" ToolTip="Drag to change the order"
                                Tag="{x:Static local:SettingsWindow.RowTag}">
                    <Rectangle Style="{StaticResource LineBefore}" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x2807;&#x2807;" Foreground="#999" Margin="0,0,4,0" />
                        <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Center" Margin="0,0,4,0" Cursor="Arrow" />
                        <TextBlock Text="{Binding Title}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsGroup}" Value="True">
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Border Margin="6,0,0,0" Padding="4,0" CornerRadius="3" Background="#DDEBFF"
                                VerticalAlignment="Center"
                                Visibility="{Binding IsFirstShown, Converter={StaticResource Visible}}">
                            <TextBlock Text="thin bar" FontSize="10" Foreground="#1F4E8C" />
                        </Border>
                    </StackPanel>
                    <Rectangle Style="{StaticResource LineAfter}" />
                    </StackPanel>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="OK" Width="76" Height="28" IsDefault="True" Click="OnOk" />
            <Button Content="Apply" Width="76" Height="28" Margin="8,0,0,0" Click="OnApply" />
            <Button x:Name="CancelButton" Content="Cancel" Width="76" Height="28" Margin="8,0,0,0" IsCancel="True"
                    Click="OnCancel" />
        </StackPanel>
    </StackPanel>
</Window>
