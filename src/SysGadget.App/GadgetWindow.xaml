<Window x:Class="SysGadget.App.GadgetWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SysGadget"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SizeToContent="Height"
        Width="220"
        MouseLeftButtonDown="OnMouseLeftButtonDown">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#F01B1D23" />
        <SolidColorBrush x:Key="TextBrush" Color="#E6E8EE" />
        <SolidColorBrush x:Key="DimBrush" Color="#9AA0AE" />
        <SolidColorBrush x:Key="TrackBrush" Color="#2D313B" />
        <SolidColorBrush x:Key="BarBrush" Color="#4DA3FF" />
        <SolidColorBrush x:Key="WarnBrush" Color="#F2B84B" />
        <SolidColorBrush x:Key="CriticalBrush" Color="#F0605D" />

        <Style x:Key="BarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="4" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="{StaticResource TrackBrush}" />
            <Setter Property="Foreground" Value="{StaticResource BarBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Level}" Value="1">
                    <Setter Property="Foreground" Value="{StaticResource WarnBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="2">
                    <Setter Property="Foreground" Value="{StaticResource CriticalBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="RowTemplate">
            <StackPanel Margin="0,0,0,5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Label}" Foreground="{StaticResource DimBrush}" FontSize="11"
                               TextTrimming="CharacterEllipsis" Margin="0,0,6,0" />
                    <TextBlock Grid.Column="1" Text="{Binding ValueText}" Foreground="{StaticResource TextBrush}"
                               FontSize="11" />
                </Grid>
                <ProgressBar Value="{Binding Percent, Mode=OneWay}" Style="{StaticResource BarStyle}" Margin="0,2,0,0">
                    <ProgressBar.Visibility>
                        <Binding Path="HasBar">
                            <Binding.Converter>
                                <BooleanToVisibilityConverter />
                            </Binding.Converter>
                        </Binding>
                    </ProgressBar.Visibility>
                </ProgressBar>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="SectionTemplate">
            <StackPanel Width="{Binding DataContext.SectionWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                        Margin="0,0,0,6">
                <TextBlock Text="{Binding Title}" Foreground="{StaticResource DimBrush}" FontSize="10"
                           FontWeight="SemiBold" Margin="0,0,0,3" />
                <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource RowTemplate}" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="Settings..." Click="OnSettingsClick" />
            <MenuItem x:Name="TopmostItem" Header="Always on top" IsCheckable="True" Click="OnTopmostClick" />
            <Separator />
            <MenuItem Header="Exit" Click="OnExitClick" />
        </ContextMenu>
    </Window.ContextMenu>

    <Border Background="{StaticResource PanelBrush}" CornerRadius="6" Padding="8,8,8,2">
        <StackPanel>
            <TextBlock Text="{Binding Status}" Foreground="{StaticResource CriticalBrush}" FontSize="11"
                       TextWrapping="Wrap" Margin="0,0,0,6">
                <TextBlock.Visibility>
                    <Binding Path="HasStatus">
                        <Binding.Converter>
                            <BooleanToVisibilityConverter />
                        </Binding.Converter>
                    </Binding>
                </TextBlock.Visibility>
            </TextBlock>
            <ItemsControl ItemsSource="{Binding Sections}" ItemTemplate="{StaticResource SectionTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </StackPanel>
    </Border>
</Window>
