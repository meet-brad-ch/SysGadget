<Project>
  <!-- One version for every project; the installer build script and the release script read it too. -->
  <PropertyGroup>
    <Version>0.1.1</Version>
    <Authors>Brad Chamberlain</Authors>
    <Product>SysGadget</Product>
    <Copyright>Brad Chamberlain</Copyright>
  </PropertyGroup>
  <!-- Quality gates of every project (scripts/verify.ps1): analysers and code style run in the build. -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>
</Project>
